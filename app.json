{
  "expo": {
    "name": "Kash Chain",
    "slug": "kashchain",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kashchain.wallet"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/shop.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kashchain.wallet"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/shop.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "DEVELOPER_MODE": false,
      "eas": {
        "projectId": "68b75687-26be-4a81-b136-6e3ce73204e5"
      }
    },
    "owner": "mbugwasami",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/68b75687-26be-4a81-b136-6e3ce73204e5"
    }
  }
}
